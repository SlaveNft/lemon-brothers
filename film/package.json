{
  "name": "lemon-film",
  "private": true,
  "version": "1.0.0",
  "description": "The $LEMON film, drawn in code with Remotion from the page's own characters and the bank's own arithmetic",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "snapshot": "node snapshot.mjs",
    "voice": "node voice.mjs",
    "render": "remotion render src/index.ts LemonFilm ../docs/media/lemon.mp4 --codec=h264 --crf=20",
    "still": "remotion still src/index.ts LemonFilm"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "5.6.3"
  }
}
